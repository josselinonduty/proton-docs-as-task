#!/usr/bin/env node
/**
 * Regenerates the store screenshots and the README images.
 *
 *   assets/screenshots/  five 1280×800 PNGs, the format the Chrome Web Store
 *                        (which takes at most five) and Firefox Add-ons expect
 *   assets/readme/       sharper 2× WebP shots, cropped to the feature, plus
 *                        onboarding.webp, a short clip of converting a document
 *
 * The shots come from the dev playground (`playground/`), which mounts the real
 * board overlay and extension pages against a fake Proton Docs page, so no
 * extension install or Proton account is needed. The script starts the
 * playground itself, unless one is already listening on the port, and stops it
 * again when done. The clock is frozen and settings are seeded, so two runs
 * produce the same images.
 *
 *   node scripts/generate-screenshots
 *
 * Requirements:
 *   - playwright-core, installed without touching package.json:
 *       npm install --no-save playwright-core@1.56.0
 *   - A Chromium-based browser. The script uses, in order:
 *       1. PDT_BROWSER_PATH, if set (path to a chrome/chromium executable)
 *       2. the Google Chrome channel, if installed system-wide
 *       3. the browser Playwright manages (`npx --no playwright-core install chromium`)
 *   - ffmpeg with libwebp, for the README images (`ffmpeg -encoders | grep webp`).
 *     Without it, only the store screenshots are made.
 *
 * Runs on Linux, macOS and Windows: no shell-specific commands, and paths are
 * built with node:path.
 */
import { spawn, spawnSync } from 'node:child_process';
import { mkdir, mkdtemp, readdir, rm } from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const STORE_DIR = path.join(ROOT, 'assets', 'screenshots');
const README_DIR = path.join(ROOT, 'assets', 'readme');
const PORT = 5199;
const URL_BASE = `http://localhost:${PORT}/`;
const VIEWPORT = { width: 1280, height: 800 };
/** Due-date badges (overdue, today, soon) are computed against this moment. */
const NOW = new Date('2026-10-20T10:00:00');
/** Stored settings every page starts from; the rest are the defaults. */
const SETTINGS = { language: 'en', userAssignee: 'jo' };

async function loadPlaywright() {
  try {
    return await import('playwright-core');
  } catch {
    console.error(
      'playwright-core is not installed. Run:\n' +
        '  npm install --no-save playwright-core@1.56.0\n' +
        'then re-run this script (--no-save leaves package.json and the lockfile alone).',
    );
    process.exit(1);
  }
}

async function launchBrowser(chromium) {
  const attempts = [];
  if (process.env.PDT_BROWSER_PATH) {
    attempts.push({ executablePath: process.env.PDT_BROWSER_PATH });
  }
  attempts.push({ channel: 'chrome' }, {});

  let lastError;
  for (const options of attempts) {
    try {
      // Native controls (date inputs) follow the browser and OS language, not the page.
      return await chromium.launch({
        ...options,
        args: ['--lang=en-US'],
        env: { ...process.env, LANG: 'en_US.UTF-8', LANGUAGE: 'en_US' },
      });
    } catch (error) {
      lastError = error;
    }
  }
  throw new Error(
    `No usable browser found (${lastError?.message ?? 'unknown error'}).\n` +
      'Set PDT_BROWSER_PATH to a Chrome/Chromium executable, or run ' +
      '`npx --no playwright-core install chromium`.',
  );
}

function hasWebpEncoder() {
  const run = spawnSync('ffmpeg', ['-hide_banner', '-encoders'], { encoding: 'utf8' });
  return run.status === 0 && run.stdout.includes('libwebp_anim');
}

function ffmpeg(args) {
  const run = spawnSync('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-y', ...args], {
    encoding: 'utf8',
  });
  if (run.status !== 0) throw new Error(`ffmpeg failed: ${run.stderr}`);
}

async function isServing() {
  try {
    const res = await fetch(URL_BASE);
    return res.ok;
  } catch {
    return false;
  }
}

/** Starts vite for the playground and resolves once it answers. */
async function startPlayground() {
  if (await isServing()) return null;

  // Run vite's bin through the current Node binary: no shell, so it works the
  // same on every OS and the child can be killed reliably.
  const viteBin = path.join(ROOT, 'node_modules', 'vite', 'bin', 'vite.js');
  const child = spawn(
    process.execPath,
    [viteBin, '--config', path.join('playground', 'vite.config.mjs')],
    { cwd: ROOT, stdio: 'ignore' },
  );

  const deadline = Date.now() + 60_000;
  while (Date.now() < deadline) {
    if (await isServing()) return child;
    if (child.exitCode !== null) break;
    await new Promise((resolve) => setTimeout(resolve, 250));
  }
  child.kill();
  throw new Error(`The playground did not start on ${URL_BASE} (run \`npm install\` first?).`);
}

/**
 * Opens a playground page in a fresh context: empty storage, frozen clock,
 * seeded settings.
 */
async function openPage(
  browser,
  {
    url = '',
    colorScheme = 'light',
    scale = 1,
    viewport = VIEWPORT,
    recordVideo,
    hideChrome = false,
  } = {},
) {
  const context = await browser.newContext({
    viewport,
    deviceScaleFactor: scale,
    colorScheme,
    locale: 'en-US',
    recordVideo,
  });
  await context.clock.setFixedTime(NOW);
  await context.addInitScript((settings) => {
    const key = 'pdt-playground:sync:settings';
    if (!localStorage.getItem(key)) localStorage.setItem(key, JSON.stringify(settings));
  }, SETTINGS);
  if (hideChrome) {
    // Show only the document and the board, not the playground's own controls.
    await context.addInitScript(() => {
      document.addEventListener('DOMContentLoaded', () => {
        const style = document.createElement('style');
        style.textContent = '.pg-bar, .pg-settings { display: none !important; }';
        document.head.append(style);
      });
    });
  }
  const page = await context.newPage();
  page.on('pageerror', (error) => console.warn(`  page error: ${error.message}`));
  await page.goto(URL_BASE + url, { waitUntil: 'networkidle' });
  await page.waitForTimeout(800);
  return { context, page };
}

async function settle(page) {
  await page.waitForTimeout(400);
}

/** A full-frame store screenshot. */
async function storeShot(page, name) {
  await settle(page);
  await page.screenshot({ path: path.join(STORE_DIR, `${name}.png`) });
  console.log(`saved assets/screenshots/${name}.png`);
}

/**
 * A README image: the whole page, or the area around `locator`, saved as WebP.
 * `margin` keeps a little of the board around a cropped element for context.
 */
async function readmeShot(page, name, { locator, margin = 24 } = {}) {
  await settle(page);
  let clip;
  if (locator) {
    const box = await locator.boundingBox();
    const size = page.viewportSize();
    const x = Math.max(0, box.x - margin);
    const y = Math.max(0, box.y - margin);
    clip = {
      x,
      y,
      width: Math.min(size.width, box.x + box.width + margin) - x,
      height: Math.min(size.height, box.y + box.height + margin) - y,
    };
  }
  const png = path.join(os.tmpdir(), `pdt-${name}.png`);
  await page.screenshot({ path: png, clip });
  ffmpeg(['-i', png, '-c:v', 'libwebp', '-quality', '90', path.join(README_DIR, `${name}.webp`)]);
  await rm(png);
  console.log(`saved assets/readme/${name}.webp`);
}

const selectView = (page, label) => page.locator(`[role="tab"]:has-text("${label}")`).click();
// Sub-task cards sit inside their parent's card, so take the outermost title.
const openTask = (page, title) =>
  page.locator(`article.pdt-taskcard:has-text("${title}") .pdt-card__title`).first().click();
const details = (page) => page.locator('aside.pdt-details');
const dialog = (page) => page.locator('[role="dialog"]').last();

async function openBoardSettings(page) {
  await page.locator('button[aria-haspopup="menu"][aria-label="More actions"]').click();
  await page.locator('[role="menuitem"]:has-text("Board settings")').click();
}

async function storeSet(browser) {
  const { context, page } = await openPage(browser);
  await storeShot(page, '01-workflow');
  await selectView(page, 'List');
  await storeShot(page, '02-list');
  await selectView(page, 'Workflow');
  await openTask(page, 'API: tasks endpoint');
  await storeShot(page, '03-subtasks');
  await page.keyboard.press('Escape');
  await openBoardSettings(page);
  await storeShot(page, '04-board-settings');
  await context.close();

  const welcome = await openPage(browser, { url: 'welcome.html' });
  await storeShot(welcome.page, '05-welcome');
  await welcome.context.close();
}

async function readmeSet(browser) {
  for (const colorScheme of ['light', 'dark']) {
    const { context, page } = await openPage(browser, { colorScheme, scale: 2 });
    await readmeShot(page, `workflow-${colorScheme}`);
    await context.close();
  }

  const { context, page } = await openPage(browser, { scale: 2 });
  for (const view of ['Sections', 'Swimlane', 'List']) {
    await selectView(page, view);
    await readmeShot(page, view.toLowerCase());
  }
  await selectView(page, 'Workflow');

  // A taller window, so the panel shows the sub-task list below the fields.
  await page.setViewportSize({ width: VIEWPORT.width, height: 1180 });
  await openTask(page, 'API: tasks endpoint');
  await readmeShot(page, 'subtasks', { locator: details(page), margin: 0 });
  await page.keyboard.press('Escape');
  await page.setViewportSize(VIEWPORT);

  // The palette shortcut listens on the board, where closing the panel leaves focus.
  await page.keyboard.press('Control+k');
  await readmeShot(page, 'command-palette', { locator: dialog(page) });
  await page.keyboard.press('Escape');

  await openBoardSettings(page);
  await readmeShot(page, 'board-settings', { locator: dialog(page) });
  await context.close();

  const popup = await openPage(browser, {
    url: 'popup.html',
    scale: 2,
    viewport: { width: 320, height: 600 },
  });
  await popup.page.locator('input[placeholder]').first().fill('Draft release notes');
  await readmeShot(popup.page, 'popup', { locator: popup.page.locator('.pp'), margin: 0 });
  await popup.context.close();
}

/** An empty document becoming a board and filling up, as an animated WebP. */
async function onboardingClip(browser) {
  const dir = await mkdtemp(path.join(os.tmpdir(), 'pdt-clip-'));
  try {
    const { context, page } = await openPage(browser, {
      url: '?empty',
      recordVideo: { dir, size: VIEWPORT },
      hideChrome: true,
    });
    await page.waitForTimeout(700);
    const create = page.locator('.pdt-convert button');
    await create.hover();
    await page.waitForTimeout(400);
    await create.click();
    await page.waitForTimeout(1200);

    await page.locator('.pdt-board button.pdt-btn-primary:has-text("Add task")').click();
    const form = dialog(page);
    for (const title of ['Draft the launch plan', 'Book the venue', 'Send invitations']) {
      await form.getByPlaceholder('What needs to be done?').click();
      await page.keyboard.type(title, { delay: 45 });
      await page.keyboard.press('Enter');
      await page.waitForTimeout(350);
    }
    await form.getByRole('button', { name: 'Cancel' }).click();
    await page.waitForTimeout(2500);
    await context.close();

    const [video] = (await readdir(dir)).filter((file) => file.endsWith('.webm'));
    ffmpeg([
      ...['-ss', '0.3', '-i', path.join(dir, video)],
      ...['-vf', 'fps=12,scale=960:-1:flags=lanczos'],
      ...['-c:v', 'libwebp_anim', '-quality', '75', '-loop', '0'],
      path.join(README_DIR, 'onboarding.webp'),
    ]);
    console.log('saved assets/readme/onboarding.webp');
  } finally {
    await rm(dir, { recursive: true, force: true });
  }
}

async function main() {
  const { chromium } = await loadPlaywright();
  const withReadme = hasWebpEncoder();
  if (!withReadme) {
    console.warn('ffmpeg with libwebp not found: skipping the README images.');
  }
  await mkdir(STORE_DIR, { recursive: true });
  await mkdir(README_DIR, { recursive: true });

  const server = await startPlayground();
  const browser = await launchBrowser(chromium);

  try {
    await storeSet(browser);
    if (withReadme) {
      await readmeSet(browser);
      await onboardingClip(browser);
    }
  } finally {
    await browser.close();
    server?.kill();
  }
}

main().catch((error) => {
  console.error(error.message);
  process.exit(1);
});
