{
  "name": "proton-docs-as-task",
  "description": "A browser extension that turns Proton Docs into a lightweight task board. When a document begins with an activation marker, the extension parses its checklist content and renders it as an interactive Kanban / list view on top of the editor.",
  "version": "1.2.3",
  "type": "module",
  "license": "MIT",
  "author": "josselinonduty",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/josselinonduty/proton-docs-as-task",
  "repository": {
    "type": "git",
    "url": "https://github.com/josselinonduty/proton-docs-as-task.git"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "playground": "vite --config playground/vite.config.mjs",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit": "wxt submit",
    "submit:init": "wxt submit init",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "4.0.0",
    "i18next": "26.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lexical/list": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/yjs": "0.52.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lexical": "0.52.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.4",
    "yjs": "13.6.33"
  },
  "overrides": {
    "vite": "$vite"
  }
}
