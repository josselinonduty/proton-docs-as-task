{
  "name": "proton-docs-as-task",
  "description": "A browser extension that turns Proton Docs into a lightweight task board. When a document begins with an activation marker, the extension parses its checklist content and renders it as an interactive Kanban / list view on top of the editor.",
  "version": "0.6.1",
  "type": "module",
  "license": "MIT",
  "author": "josselinonduty",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/josselinonduty/proton-docs-as-task",
  "repository": {
    "type": "git",
    "url": "https://github.com/josselinonduty/proton-docs-as-task.git"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit": "wxt submit",
    "submit:init": "wxt submit init",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.0",
    "wxt": "^0.21.4"
  }
}
