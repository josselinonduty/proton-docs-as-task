    "syntax": {
      "title": "Task syntax",
      "intro": "Below the marker line, write your tasks as a checklist. The board updates live as you type. Status and section are independent: a task's <code>@status</code> is its workflow stage, while its <code>## Heading</code> is the section it lives under.",
      "task": "<code>- [ ]</code> / <code>- [x]</code> — an open or done task",
      "section": "<code>## Heading</code> — a section (the Sections view groups by these)",
      "status": "<code>@settings status review \"In review\" @category:doing</code> — defines a status (one line each, right below the marker). Manage them from the board's <em>Board settings</em>; a board without any uses To Do · In Progress · Done",
      "statusRef": "<code>@status:review</code> — the task's status, by key (a ticked checkbox means the first Done status; built-in shorthands like <code>@s:wip</code> still work)",
      "priority": "<code>@priority:high</code> — high · medium · low (also <code>!</code>/<code>!!</code>/<code>!!!</code>)",
      "due": "<code>@due:2026-09-10</code> — a due date",
      "who": "<code>@who:alex</code> or <code>@@alex</code> — an assignee",
      "label": "<code>#label</code> — one or more labels",
      "parent": "<code>@parent:key</code> — makes the task a sub-task of the one marked <code>@id:key</code> (managed from the task panel); a task can't be completed while a sub-task is open"
