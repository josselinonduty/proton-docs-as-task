{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // No ambient test globals: tests import `describe`, `it`, `vi`… from
    // `vitest`, so production code can't reference them by accident.
    "types": []
  }
}
